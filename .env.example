# Secret used to sign session tokens (JWT). Use a long random string (32+ chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a login session lasts, in hours.
SESSION_TTL_HOURS=8

# Database connection. SQLite file for local development.
# For PostgreSQL: postgresql://user:password@host:5432/dbname (and change provider in prisma/schema.prisma)
DATABASE_URL=file:./prisma/dev.db

# Public URL of the app, used to build invite and password-reset links.
APP_URL=http://localhost:3000
