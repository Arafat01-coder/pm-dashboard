// Database schema. After changing it run: npm run db:migrate
// SQLite for local development; switch provider to "postgresql" for production.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  /// One of: super_admin, admin, project_manager, member, client
  role           String
  title          String   @default("")
  isActive       Boolean  @default(true)
  /// Bumped on password change/reset to sign out other sessions.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownedProjects   Project[]            @relation("ProjectOwner")
  memberships     ProjectMember[]
  assignedTasks   Task[]               @relation("TaskAssignee")
  createdTasks    Task[]               @relation("TaskCreator")
  comments        Comment[]
  activities      ActivityLog[]
  invitationsSent Invitation[]
  resetTokens     PasswordResetToken[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  /// One of: planning, active, on_hold, completed
  status      String    @default("planning")
  dueDate     DateTime?
  ownerId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner      User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members    ProjectMember[]
  tasks      Task[]
  activities ActivityLog[]
}

model ProjectMember {
  projectId String
  userId    String
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String    @default("")
  /// One of: todo, in_progress, review, done
  status      String    @default("todo")
  /// One of: low, medium, high, urgent
  priority    String    @default("medium")
  assigneeId  String?
  createdById String
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User      @relation("TaskCreator", fields: [createdById], references: [id])
  comments  Comment[]

  @@index([projectId])
  @@index([assigneeId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String
  /// Short sentence shown in the UI, e.g. "moved Login page to Done".
  summary    String
  /// e.g. project.created, task.status_changed, user.role_changed
  action     String
  entityType String
  entityId   String
  projectId  String?
  createdAt  DateTime @default(now())

  actor   User     @relation(fields: [actorId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        String
  /// SHA-256 of the token in the invite link; the raw token is never stored.
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  invitedBy User @relation(fields: [invitedById], references: [id])

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the token in the reset link; the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
